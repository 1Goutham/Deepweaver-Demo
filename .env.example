# Contact form → email. The route handler at /api/contact sends each enquiry
# through Resend's HTTP API. Every value below is read from the hosting
# environment at request time; nothing is baked into the build.
#
# One codebase, per-environment values:
#   - Vercel demo / staging : the staging Resend key and its sender
#   - Netlify / production  : the production Resend key and a sender on the
#                             verified deepweaver.ai domain
# Never commit real values. This file documents names and formats only.

# Required. Resend → API Keys. Different key per environment.
RESEND_API_KEY=

# Required. Sender shown on the notification. Must be on a domain verified in
# the Resend account that owns the key (production: deepweaver.ai).
CONTACT_FROM_EMAIL="DeepWeaver Website <website@deepweaver.ai>"

# Optional. Inbox(es) that receive enquiries, comma-separated.
# Defaults to the site contact address (contact@deepweaver.ai).
CONTACT_TO_EMAIL=contact@deepweaver.ai

# Optional. Google Analytics measurement ID for the consent-gated analytics.
NEXT_PUBLIC_GA_ID=
