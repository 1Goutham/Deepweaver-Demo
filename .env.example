# Contact form → email. Set these in the hosting environment; never commit real values.
# The route handler at /api/contact sends each enquiry through Resend's HTTP API.

# Required. Create at https://resend.com → API Keys.
RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to the site contact address.
CONTACT_TO_EMAIL=contact@deepweaver.ai

# Sender. Must be on a domain verified in Resend (e.g. deepweaver.ai).
# Until the domain is verified, Resend's test sender can only deliver to the
# account owner's own address.
CONTACT_FROM_EMAIL="DeepWeaver Website <website@deepweaver.ai>"

# Optional. Google Analytics measurement ID for the consent-gated analytics.
NEXT_PUBLIC_GA_ID=
